rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isMoney(value) {
      return value is int && value >= 0;
    }

    function validClientData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.description is string && data.description.size() <= 500
        && isMoney(data.initialDebt) && isMoney(data.totalPaid) && isMoney(data.balance)
        && data.balance == data.initialDebt - data.totalPaid
        && data.status in ['active', 'settled', 'archived'];
    }

    function validDebtData(data) {
      return data.clientId is string && data.clientId.size() > 0
        && data.label is string && data.label.size() > 0 && data.label.size() <= 120
        && isMoney(data.initialAmount) && isMoney(data.principalPaid) && isMoney(data.accruedInterest) && isMoney(data.outstandingBalance)
        && data.outstandingBalance == data.initialAmount - data.principalPaid + data.accruedInterest
        && data.status in ['onTime', 'dueSoon', 'overdue', 'settled']
        && data.interest is map
        && data.interest.enabled is bool
        && data.interest.rate is number && data.interest.rate >= 0
        && data.interest.frequency in ['monthly', 'weekly', 'daily']
        && data.interest.calculation in ['simple', 'compound']
        && data.interest.graceDays is number && data.interest.graceDays >= 0;
    }

    match /users/{uid} {
      allow read, write: if false;

      match /profile/{document} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'currency', 'dateFormat', 'createdAt', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /clients/{clientId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validClientData(request.resource.data)
          && request.resource.data.initialDebt > 0
          && request.resource.data.totalPaid == 0
          && request.resource.data.balance == request.resource.data.initialDebt
          && request.resource.data.status == 'active';
        allow update: if isOwner(uid)
          && validClientData(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'description', 'initialDebt', 'totalPaid', 'balance', 'status', 'updatedAt'
          ]);
        allow delete: if false;

        match /debts/{debtId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && validDebtData(request.resource.data)
            && request.resource.data.clientId == clientId;
          allow update: if isOwner(uid)
            && validDebtData(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'principalPaid', 'accruedInterest', 'outstandingBalance', 'status', 'updatedAt'
            ]);
          allow delete: if false;

          match /interestEntries/{entryId} {
            allow read: if isOwner(uid);
            allow create: if isOwner(uid)
              && request.resource.data.keys().hasOnly([
                'debtId', 'amount', 'rate', 'periodStart', 'periodEnd', 'appliedAt', 'calculationType'
              ])
              && request.resource.data.debtId == debtId
              && request.resource.data.amount is int && request.resource.data.amount > 0
              && request.resource.data.rate is number && request.resource.data.rate >= 0
              && request.resource.data.periodStart is string
              && request.resource.data.periodEnd is string
              && request.resource.data.appliedAt is timestamp
              && request.resource.data.calculationType in ['simple', 'compound'];
            allow update, delete: if false;
          }
        }

        match /payments/{paymentId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly([
              'clientId', 'clientName', 'debtId', 'debtLabel', 'amount', 'date', 'note', 'status',
              'createdAt', 'voidedAt', 'voidReason'
            ])
            && request.resource.data.clientId == clientId
            && request.resource.data.clientName is string
            && request.resource.data.debtId is string
            && request.resource.data.debtId.size() > 0
            && request.resource.data.debtId.size() <= 100
            && request.resource.data.debtLabel is string
            && request.resource.data.debtLabel.size() <= 120
            && request.resource.data.amount is int && request.resource.data.amount > 0
            && request.resource.data.date is timestamp
            && request.resource.data.note is string && request.resource.data.note.size() <= 500
            && request.resource.data.status == 'active'
            && request.resource.data.voidedAt == null
            && request.resource.data.voidReason == ''
            && request.resource.data.amount <= get(/databases/$(database)/documents/users/$(uid)/clients/$(clientId)).data.balance
            && get(/databases/$(database)/documents/users/$(uid)/clients/$(clientId)).data.status in ['active'];
          allow update: if isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'voidedAt', 'voidReason'
            ])
            && resource.data.status == 'active'
            && request.resource.data.status == 'voided'
            && request.resource.data.voidedAt is timestamp
            && request.resource.data.voidReason is string
            && request.resource.data.voidReason.size() > 0
            && request.resource.data.voidReason.size() <= 300;
          allow delete: if false;
        }
      }
    }
  }
}
